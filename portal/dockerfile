# ----- Stage 1: Build -----
FROM node:24-alpine AS build
WORKDIR /app

# Nur die Manifeste für Dependencies kopieren (bessere Layer-Caches)
COPY package*.json ./

# Installiere Dependencies reproduzierbar
RUN npm ci

# Restlichen Source-Code kopieren und Build erzeugen
COPY . .
ENV NODE_ENV=production
ARG VITE_ARGOCD_UI_URL
ENV VITE_ARGOCD_UI_URL=$VITE_ARGOCD_UI_URL
ARG VITE_TEAMS_CHAT_URL
ENV VITE_TEAMS_CHAT_URL=$VITE_TEAMS_CHAT_URL
ARG VITE_DOCS_DEPLOYMENT_GUIDE_URL
ENV VITE_DOCS_DEPLOYMENT_GUIDE_URL=$VITE_DOCS_DEPLOYMENT_GUIDE_URL
ARG VITE_DOCS_CONVENTIONS_URL
ENV VITE_DOCS_CONVENTIONS_URL=$VITE_DOCS_CONVENTIONS_URL
ARG VITE_DOCS_CICD_PIPELINE_URL
ENV VITE_DOCS_CICD_PIPELINE_URL=$VITE_DOCS_CICD_PIPELINE_URL
ARG VITE_DOCS_TROUBLESHOOTING_URL
ENV VITE_DOCS_TROUBLESHOOTING_URL=$VITE_DOCS_TROUBLESHOOTING_URL
ARG VITE_DOCS_FLYER_URL
ENV VITE_DOCS_FLYER_URL=$VITE_DOCS_FLYER_URL
RUN npm run build

# ----- Stage 2: Static Serve mit Nginx -----
FROM nginx:1.29-alpine

# Standard-Site entfernen und eigene Nginx-Config kopieren
RUN rm /etc/nginx/conf.d/default.conf
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Gebautes Frontend nach Nginx Webroot
COPY --from=build /app/dist /usr/share/nginx/html

# Standard-Port
EXPOSE 80

# Hinweis: Healthchecks macht Kubernetes (readiness/livenessProbes).
# Der Container-Healthcheck ist nicht nötig und spart Imagegröße.

# Nginx im Vordergrund starten
CMD ["nginx", "-g", "daemon off;"]
